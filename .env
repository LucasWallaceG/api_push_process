# ==== AUTENTICAÇÃO RABBITMQ ==== #
HOST_RABBITMQ=192.168.11.38 # Default: localhost | 192.168.11.38
PORT_RABBITMQ=5672
VHOST=/myvhost # Default: / | myvhost
USER=ro.berto # Default: guest
PASSWORD=Jrs-2018 # Default: guest

# ==== RABBITMQ EXCHANGE ==== #
EXCHANGE=push_exchange

# ==== RABBITMQ QUEUE ==== #
QUEUE_RECEIVED_EVENT_PUSH=queue_received_event_push

# ==== RABBITMQ ROUTING KEY ==== #
RECEIVED_EVENT_PUSH_KEY=received_event_push_key

# ==== URL PUBLICA DESTE SERVICO (para montar a URL absoluta dos screenshots) ==== #
# OPCIONAL. Por padrao o IP da maquina e detectado automaticamente em runtime,
# entao roda em qualquer IP sem configurar nada.
#
# Defina PUSH_PUBLIC_URL apenas se precisar forcar um host/dominio especifico
# (ex.: atras de reverse-proxy ou acesso externo por dominio):
#   PUSH_PUBLIC_URL=http://meu-dominio-ou-ip:5000
#
# Ou apenas ajuste a porta (mantendo a deteccao automatica do IP):
PUSH_PUBLIC_PORT=5000

# ==== TIMEOUT DO POST DE RETORNO (webhook aos sistemas externos) ==== #
# Em segundos. Aumente RETORNO_READ_TIMEOUT se a app de origem demora a responder
# (evita 'Read timed out'). connect = tempo para abrir a conexao; read = resposta.
RETORNO_CONNECT_TIMEOUT=5
RETORNO_READ_TIMEOUT=30